{
  "name": "atom-code",
  "productName": "ATOM Code",
  "version": "0.1.0",
  "description": "ATOM Code — an AI-native code editor with a Claude-powered agent harness.",
  "author": "Ömer Faruk Bilen",
  "homepage": "https://github.com/omerfarukbilen/atom-code",
  "repository": {
    "type": "git",
    "url": "https://github.com/omerfarukbilen/atom-code.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');for(const a of ['arm64','x64']){try{fs.chmodSync(path.join('node_modules','node-pty','prebuilds','darwin-'+a,'spawn-helper'),0o755)}catch{}}\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.299",
    "@vscode/ripgrep": "^1.18.0",
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0",
    "simple-git": "^3.36.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.57.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
